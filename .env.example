# WordPress GraphQL API URL - Change to your production WordPress site
NEXT_PUBLIC_WORDPRESS_API_URL=https://your-wordpress-site.com/graphql

# Production site URL (used for sitemap, robots.txt, and meta tags)
NEXT_PUBLIC_SITE_URL=https://puritypharma.com

# Optional: Revalidation token for on-demand ISR
REVALIDATE_TOKEN=your_secret_token_here
